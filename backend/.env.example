# ============================================================
# InterLockerUp — Backend (referencia de variables de entorno)
# Copia este archivo a .env y ajusta los valores.
# ============================================================

# ---------- Base de datos ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=interlockerup
# search_path fijo en config/db.js: gestion,iot,public

# ---------- Servidor ----------
PORT=3000
NODE_ENV=development            # development | production
APP_URL=http://localhost:5173   # URL pública del frontend (links en correos)

# ---------- Autenticación ----------
JWT_SECRET=cambia-este-secreto
ADMIN_SESSION_HOURS=12
ADMIN_SINGLE_SESSION=true
IOT_SECRET_KEY=cambia-esta-clave-iot

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MIN=15
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MIN=15

# ---------- Correo (Resend) ----------
RESEND_API_KEY=re_xxx
RESEND_FROM=InterLockerUp <no-reply@interlockerup.xyz>

# ---------- Respaldos ----------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=90
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ============================================================
# ROTACIÓN CUATRIMESTRAL Y RETENCIÓN DE REGISTROS
# ============================================================

# Días con antelación a la fecha de cierre del periodo en que se
# envía la notificación global + correo a los usuarios con asignación
# activa. (Cron de notificación: 09:00 diaria; se envía una sola vez
# por periodo, controlado en gestion.rotation_state.)
ROTATION_NOTICE_DAYS=30

# Días de gracia para que un estudiante pueda solicitar un nuevo
# casillero después de que su periodo anterior venció.
REQUEST_GRACE_DAYS=30

# Retención de accesos registrados (gestion.access_logs).
ACCESS_LOG_RETENTION_DAYS=365

# Retención de notificaciones leídas (gestion.notifications).
NOTIF_RETENTION_DAYS=180

# Retención de comandos IoT (iot.iot_commands).
IOT_CMD_RETENTION_DAYS=1

# Retención de solicitudes de casillero ya resueltas (rechazadas /
# canceladas / aceptadas). Las pendientes NUNCA se purgan.
REQUESTS_DONE_RETENTION_DAYS=180

# Retención de logs de seguridad (iot.security_logs).
SECURITY_LOG_RETENTION_DAYS=365

# Retención de incidentes resueltos (gestion.incidents).
# Los incidentes abiertos (nuevo/en_proceso) NUNCA se purgan.
INCIDENTS_DONE_RETENTION_DAYS=720

# Retención de dispositivos registrados inactivos (gestion.user_devices).
# Solo se eliminan si el usuario ya no tiene sesión activa.
USER_DEVICES_IDLE_DAYS=365
